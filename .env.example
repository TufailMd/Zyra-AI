# Backend HTTP port. Optional; backend/index.js falls back to 5000.
PORT=5000

# MongoDB connection string. Required for database-backed backend functionality.
MONGODB_URL=

# JWT signing and verification secret. Required for authentication.
# Use a strong, unique secret in each deployed environment.
JWT_SECRET=

# Required for file uploads. No default is provided.
CLOUDINARY_CLOUD_NAME=
# Required for file uploads. No default is provided.
CLOUDINARY_API_KEY=
# Required for file uploads. Keep this credential private.
CLOUDINARY_API_SECRET=

# Required for assistant requests; provide the full API endpoint URL. The source defines no default endpoint.
GEMINI_API_URL=
# Required for assistant requests; provide the model identifier expected by the configured endpoint.
GEMINI_MODEL=
# Required for assistant requests. This key is sent to the API; keep it private and out of frontend code.
GEMINI_API_KEY=
